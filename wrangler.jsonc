{
  "name": "cairn-landing",
  "compatibility_date": "2026-07-13",

  // Static site: everything under public/ is served as-is, no Worker script needed.
  // Keeping assets in their own directory (rather than the repo root) also keeps
  // wrangler dev's file watcher away from .git/ and .wrangler/, which otherwise
  // triggers a reload loop.
  "assets": {
    "directory": "./public"
  },

  // Pre-launch: no <name>.workers.dev URL and no versioned preview URLs,
  // so the site is only reachable through the route below.
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    { "pattern": "opencairn.ai", "custom_domain": true }
  ]
}
